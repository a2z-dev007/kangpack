# ==============================================================================
# Kangpack Frontend - Production Environment Configuration (.env.production)
# ==============================================================================

# Backend Public API URL (Accessible over HTTPS via Nginx reverse proxy)
NEXT_PUBLIC_API_URL=https://api.kangpack.in/api/v1

# Frontend Public Web URL
NEXT_PUBLIC_APP_URL=https://kangpack.in

# Backend Assets / Uploads URL
NEXT_PUBLIC_APP_ASSETS=https://api.kangpack.in/

# Payment Gateway Public Key (Razorpay Production or Test Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
