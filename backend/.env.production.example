# ==============================================================================
# Kangpack Backend - Production Environment Configuration (.env.production)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=8000

# Local MongoDB Configuration (Secured with local authentication)
# Replace <DB_PASSWORD> with the password set via deploy/scripts/init-mongo-users.js
MONGODB_URI=mongodb://kangpack_user:<DB_PASSWORD>@127.0.0.1:27017/kangpack_production?authSource=kangpack_production

# JWT Authentication Secrets (Generate 32+ characters using: openssl rand -base64 32)
JWT_ACCESS_SECRET=replace_with_openssl_generated_32_char_access_secret_here
JWT_REFRESH_SECRET=replace_with_openssl_generated_32_char_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security (Generate 16+ characters using: openssl rand -base64 16)
COOKIE_SECRET=replace_with_openssl_generated_cookie_secret_here
BCRYPT_SALT_ROUNDS=12

# Domain & CORS Configuration
FRONTEND_URL=https://kangpack.in
CORS_ORIGIN=https://kangpack.in,https://www.kangpack.in

# File Upload Configuration (Local uploads stored on VPS NVMe SSD)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads

# Rate Limiting (15 minutes window, max 300 requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Email Delivery Configuration (Hostinger Business Email or GoDaddy or Gmail App Password)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@kangpack.in
SMTP_PASS=replace_with_email_password
FROM_EMAIL=support@kangpack.in
FROM_NAME="Kangpack Support"

# Payment Gateway (Razorpay Production / Test Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudflare R2 Object Storage (Replacing local uploads)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Public Access URL (e.g., https://pub-xxxx.r2.dev or custom domain https://assets.kangpack.in)
R2_PUBLIC_URL=https://assets.kangpack.in
